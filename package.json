{
  "name": "brand-video-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous Hexagonal Brand Video Studio powered by Remotion, Hyperframes, yt-dlp, whisper.cpp, and FFmpeg",
  "scripts": {
    "dev": "remotion preview src/composition/index.ts",
    "render": "remotion render src/composition/index.ts BrandVideo output/design-patterns/remotion.mp4 --concurrency 1",
    "studio": "tsx src/adapters/driving/cli/StudioCli.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test src/test/**/*.test.ts"
  },
  "dependencies": {
    "@remotion/captions": "^4.0.260",
    "@remotion/cli": "^4.0.260",
    "@remotion/player": "^4.0.260",
    "lucide-react": "^1.16.0",
    "puppeteer": "^24.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.260",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "hyperframes": "^0.8.223",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=7.29.1",
      "basic-ftp": ">=6.2.1"
    }
  }
}
